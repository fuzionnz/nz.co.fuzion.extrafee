<?xml version="1.0"?>
<extension key="nz.co.fuzion.extrafee" type="module">
  <file>extrafee</file>
  <name>Extra Fee on Total Amount</name>
  <description>Add a percentage plus fixed fee when using a payment processor</description>
  <license>AGPL-3.0</license>
  <maintainer>
    <author>Jitendra Purohit</author>
    <email>jitendra@fuzion.co.nz</email>
  </maintainer>
  <urls>
    <url desc="Main Extension Page">https://github.com/fuzionnz/nz.co.fuzion.extrafee</url>
    <url desc="Licensing">http://www.gnu.org/licenses/agpl-3.0.html</url>
  </urls>
  <releaseDate>2026-10-06</releaseDate>
  <version>1.4.1</version>
  <develStage>beta</develStage>
  <compatibility>
    <ver>6.15</ver>
  </compatibility>
  <php_compatibility>
    <ver>8.1</ver>
    <ver>8.2</ver>
    <ver>8.3</ver>
    <ver>8.4</ver>
  </php_compatibility>
  <civix>
    <namespace>CRM/Extrafee</namespace>
    <format>23.02.1</format>
  </civix>
  <mixins>
    <mixin>menu-xml@1.0.0</mixin>
    <mixin>smarty-v2@1.0.1</mixin>
  </mixins>
  <classloader>
    <psr0 prefix="CRM_" path="."/>
    <psr4 prefix="Civi\" path="Civi"/>
  </classloader>
  <upgrader>CRM_Extrafee_Upgrader</upgrader>
</extension>
